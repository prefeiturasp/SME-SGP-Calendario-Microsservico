# Django
DJANGO_SECRET_KEY=sua-chave-secreta-aqui
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=hosts_permitidos_separados_por_virgula

# Autenticacao entre servicos (API Key)
API_KEY=sua-api-key-aqui
API_KEY_HEADER=X-API-Key

# Banco de dados do Calendario
# Formato: postgresql://usuario:senha@host:porta/nome_banco
URL_BANCO_CALENDARIO=url_banco_calendario
DB_POOL_SIZE=5

# Container PostgreSQL do docker-compose-dev.yml
POSTGRES_DB=nome_banco_calendario
POSTGRES_USER=usuario_banco_calendario
POSTGRES_PASSWORD=senha_banco_calendario

# Portas expostas no host (desenvolvimento)
PORT_WEB=porta_web
PORT_DEBUGPY=porta_debugpy
